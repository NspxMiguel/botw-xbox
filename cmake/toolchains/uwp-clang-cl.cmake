# Cross-compile UWP on macOS with Microsoft's unpacked SDK/CRT and LLVM.
set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_PROCESSOR AMD64)
set(XWIN_ROOT "$ENV{HOME}/.local/share/nxbox/xwin/sdk" CACHE PATH "Unpacked xwin SDK and MSVC CRT")
set(VCPKG_UWP_ROOT "$ENV{HOME}/.local/share/nxbox/vcpkg-uwp" CACHE PATH "Unpacked vcpkg UWP and desktop trees")
set(CMAKE_C_COMPILER /opt/homebrew/opt/llvm/bin/clang-cl)
set(CMAKE_CXX_COMPILER /opt/homebrew/opt/llvm/bin/clang-cl)
set(CMAKE_C_COMPILER_TARGET x86_64-pc-windows-msvc)
set(CMAKE_CXX_COMPILER_TARGET x86_64-pc-windows-msvc)
set(CMAKE_LINKER /opt/homebrew/bin/lld-link)
set(CMAKE_AR /opt/homebrew/opt/llvm/bin/llvm-lib)
set(CMAKE_RC_COMPILER /opt/homebrew/opt/llvm/bin/llvm-rc)
set(CMAKE_MT /opt/homebrew/opt/llvm/bin/llvm-mt)
set(CMAKE_MSVC_RUNTIME_LIBRARY MultiThreadedDLL)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
set(CMAKE_TRY_COMPILE_PLATFORM_VARIABLES XWIN_ROOT VCPKG_UWP_ROOT)

set(_uwp_includes "/imsvc\"${XWIN_ROOT}/crt/include\"")
foreach(_part ucrt um shared winrt cppwinrt)
  string(APPEND _uwp_includes " /imsvc\"${XWIN_ROOT}/sdk/include/10.0.26100/${_part}\"")
endforeach()
# The 14.44 STL imports the C environment functions unconditionally.
# Expose CRT declarations while preserving UWP Windows API partition guards.
set(CMAKE_C_FLAGS_INIT "${_uwp_includes} /DWINAPI_FAMILY=WINAPI_FAMILY_APP /D_UNICODE /DUNICODE /D_CRT_USE_WINAPI_FAMILY_DESKTOP_APP")
set(CMAKE_CXX_FLAGS_INIT "${CMAKE_C_FLAGS_INIT} /EHsc")
set(_uwp_libpaths "")
foreach(_dir crt/lib/x86_64/store crt/lib/x86_64 sdk/lib/um/x86_64 sdk/lib/ucrt/x86_64)
  string(APPEND _uwp_libpaths " /LIBPATH:\"${XWIN_ROOT}/${_dir}\"")
endforeach()
set(CMAKE_EXE_LINKER_FLAGS_INIT "${_uwp_libpaths} /APPCONTAINER WindowsApp.lib")
set(CMAKE_SHARED_LINKER_FLAGS_INIT "${_uwp_libpaths} /APPCONTAINER WindowsApp.lib")
# Desktop defaults include kernel32/user32; WindowsApp supplies the UWP API set.
set(CMAKE_C_STANDARD_LIBRARIES "WindowsApp.lib" CACHE STRING "UWP system libraries")
set(CMAKE_CXX_STANDARD_LIBRARIES "WindowsApp.lib" CACHE STRING "UWP system libraries")
set(BOTW_DXC_ROOT "${VCPKG_UWP_ROOT}/x64-windows" CACHE PATH "Desktop DXC headers and runtime tree")
list(PREPEND CMAKE_PREFIX_PATH "${VCPKG_UWP_ROOT}/x64-uwp")
set(CMAKE_FIND_ROOT_PATH "${VCPKG_UWP_ROOT}/x64-uwp" "${XWIN_ROOT}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
