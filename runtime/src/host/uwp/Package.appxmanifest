              <uap:FileType>.sstats</uap:FileType>
              <uap:FileType>.tscb</uap:FileType>
            </uap:SupportedFileTypes>
          </uap:FileTypeAssociation>
        </uap:Extension>
      </Extensions>
    </Application>
  </Applications>
  <!-- broadFileSystemAccess is unsupported on Xbox; internetClient is used for mod downloads. -->
  <Capabilities><Capability Name="internetClient" /><uap:Capability Name="removableStorage" /></Capabilities>
</Package>
